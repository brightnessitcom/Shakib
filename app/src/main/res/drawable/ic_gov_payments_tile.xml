<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="40dp"
    android:height="40dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- Triangular Bank Roof (Single closed triangle) -->
    <path
        android:strokeColor="#72D09D"
        android:strokeWidth="2.0"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 9,19.5 L 24,9 L 39,19.5 Z" />

    <!-- 4 Vertical Columns (2 full height to plinth, 2 meeting top of banknote) -->
    <path
        android:strokeColor="#72D09D"
        android:strokeWidth="2.0"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 13.5,19.5 L 13.5,32.5 M 20.5,19.5 L 20.5,32.5 M 27.5,19.5 L 27.5,29 M 34.5,19.5 L 34.5,29" />

    <!-- Left Stepped Plinth Base (connected to left side of banknote) -->
    <path
        android:strokeColor="#72D09D"
        android:strokeWidth="2.0"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 24.5,32.5 L 12.5,32.5 L 9.5,35.5 L 9.5,38.5 L 24.5,38.5" />

    <!-- Banknote Rectangle in Bottom-Right -->
    <path
        android:strokeColor="#72D09D"
        android:strokeWidth="2.0"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 26.5,29 L 38.5,29 A 2,2 0 0,1 40.5,31 L 40.5,39.5 A 2,2 0 0,1 38.5,41.5 L 26.5,41.5 A 2,2 0 0,1 24.5,39.5 L 24.5,31 A 2,2 0 0,1 26.5,29 Z" />

    <!-- Solid Circle inside Banknote -->
    <path
        android:fillColor="#72D09D"
        android:pathData="M 32.5,32.8 A 2.45,2.45 0 1,1 32.49,32.8 Z" />

</vector>
