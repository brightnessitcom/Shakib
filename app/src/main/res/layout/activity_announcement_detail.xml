<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/announcement_bg"
    android:orientation="vertical">

    <!-- Top Bar: Back Arrow + Title (Announcement) -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/announcement_bg"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/arrow_l"
            app:tint="@color/announcement_top_icon_tint"
            android:contentDescription="Back"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/ivBack"
            android:layout_centerVertical="true"
            android:layout_marginStart="24dp"
            android:text="Announcement"
            android:textColor="@color/announcement_title_text"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Content: Announcement Details Card -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/announcement_card_bg"
                app:strokeColor="@color/announcement_card_stroke"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Title Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvAnnouncementTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="1 أكتوبر موعد انطلاق معرض الصقور والصيد السعودي الدولي &quot;وجهة للجميع&quot;"
                            android:textColor="@color/announcement_item_title"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:gravity="end"
                            android:textAlignment="viewEnd"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/announcement_divider" />

                    <!-- Details Body -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvAnnouncementBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="يدعوكم المركز الوطني للصقور لزيارة معرض الصقور والصيد السعودي الدولي 2026، الذي يقام خلال الفترة من 1 إلى 10 أكتوبر من الساعة 2 ظهرًا حتى 11 مساءً بملهم."
                            android:textColor="@color/announcement_detail_body"
                            android:textSize="14sp"
                            android:gravity="end"
                            android:textAlignment="viewEnd"
                            android:lineSpacingExtra="4dp" />

                        <TextView
                            android:id="@+id/tvAnnouncementSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="الدخول مجانًا، سجّل زيارتك الآن:"
                            android:textColor="@color/announcement_item_title"
                            android:textSize="14sp"
                            android:gravity="end"
                            android:textAlignment="viewEnd" />

                        <!-- Clickable Link Row -->
                        <LinearLayout
                            android:id="@+id/layoutLink"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvAnnouncementLink"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="https://fhe.sfc.org.sa/visitor-registration"
                                android:textColor="@color/announcement_detail_link"
                                android:textSize="14sp" />

                            <ImageView
                                android:id="@+id/ivLinkIcon"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="6dp"
                                android:src="@drawable/ic_link"
                                app:tint="@color/announcement_detail_link"
                                android:contentDescription="Link" />
                        </LinearLayout>

                        <!-- Timestamp -->
                        <TextView
                            android:id="@+id/tvAnnouncementDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:text="Received on Monday 28 September 2026 1:09 PM"
                            android:textColor="@color/announcement_item_text_secondary"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
