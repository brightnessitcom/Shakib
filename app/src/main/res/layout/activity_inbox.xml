<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/inbox_background"
    android:orientation="vertical">

    <!-- Top Bar: Close (X) + Title (Inbox) + More (...) -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_close"
            app:tint="@color/inbox_top_icon_tint"
            android:contentDescription="Close"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/ivClose"
            android:layout_centerVertical="true"
            android:layout_marginStart="24dp"
            android:text="Inbox"
            android:textColor="@color/inbox_empty_title_color"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivMore"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_more_horiz"
            app:tint="@color/inbox_top_icon_tint"
            android:contentDescription="More"
            android:clickable="true"
            android:focusable="true" />
    </RelativeLayout>

    <!-- Tabs Bar -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@color/inbox_background"
        app:tabIndicatorColor="@color/inbox_tab_indicator"
        app:tabIndicatorHeight="3dp"
        app:tabIndicatorFullWidth="true"
        app:tabSelectedTextColor="@color/inbox_tab_selected_text"
        app:tabTextColor="@color/inbox_tab_unselected_text"
        app:tabTextAppearance="@style/InboxTabText"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabRippleColor="@android:color/transparent">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notifications" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Announcements" />
    </com.google.android.material.tabs.TabLayout>

    <!-- Divider Line below tabs -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inbox_tab_divider" />

    <!-- Container for Tab Contents -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- TAB 1: Notifications (Empty State matching official Absher) -->
        <LinearLayout
            android:id="@+id/layoutNotifications"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:visibility="visible">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="65dp"
                android:src="@drawable/ic_inbox_bell_empty"
                app:tint="@color/inbox_empty_icon_tint"
                android:contentDescription="No Notifications" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="No Notifications"
                android:textColor="@color/inbox_empty_title_color"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="You’re all caught up. Once you have new notifications, they will display here."
                android:textColor="@color/inbox_empty_subtitle_color"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <!-- TAB 2: Announcements (Empty State matching official Absher) -->
        <LinearLayout
            android:id="@+id/layoutAnnouncements"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="65dp"
                android:src="@drawable/ic_inbox_bell_empty"
                app:tint="@color/inbox_empty_icon_tint"
                android:contentDescription="No Announcements" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="No Announcements"
                android:textColor="@color/inbox_empty_title_color"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="You’re all caught up. Once you have new announcements, they will display here."
                android:textColor="@color/inbox_empty_subtitle_color"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>