<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/app_background"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">
        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/arrow_l"
            app:tint="@color/icon_tint_primary"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp">
            <ImageView
                android:id="@+id/ivLogoLeft"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ab2"
                app:tint="@color/login_logo_tint"/>
            <ImageView
                android:id="@+id/ivLogoRight"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ministry_ic"
                android:layout_marginStart="8dp"
                app:tint="@color/login_logo_tint"/>
        </LinearLayout>
        <TextView
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/verification_title"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tvInstruction1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/verification_instruction"/>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="32dp">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:id="@+id/tvPhoneNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="******0000"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/text_secondary"
                android:id="@+id/tvPhoneNumberNormal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/via_sms"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/codeContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <EditText
                android:textSize="20sp"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:id="@+id/etCode1"
                android:background="@drawable/code_box_default"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:cursorVisible="true"
                android:maxLength="1"
                android:inputType="number"
                android:layout_marginEnd="12dp"/>
            <EditText
                android:textSize="20sp"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:id="@+id/etCode2"
                android:background="@drawable/code_box_default"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:cursorVisible="true"
                android:maxLength="1"
                android:inputType="number"
                android:layout_marginEnd="12dp"/>
            <EditText
                android:textSize="20sp"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:id="@+id/etCode3"
                android:background="@drawable/code_box_default"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:cursorVisible="true"
                android:maxLength="1"
                android:inputType="number"
                android:layout_marginEnd="12dp"/>
            <EditText
                android:textSize="20sp"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:id="@+id/etCode4"
                android:background="@drawable/code_box_default"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:cursorVisible="true"
                android:maxLength="1"
                android:inputType="number"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="#d32f2f"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tvError"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/incorrect_code"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="bottom"
        android:id="@+id/bottomContainer"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.button.MaterialButton
            android:textColor="@color/login_btn_active_text"
            android:id="@+id/btnUseAuthenticator"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="@string/use_absher_authenticator"
            android:textAllCaps="false"
            app:backgroundTint="@color/login_btn_active_bg"
            app:cornerRadius="14dp"/>
    </LinearLayout>
</FrameLayout>
