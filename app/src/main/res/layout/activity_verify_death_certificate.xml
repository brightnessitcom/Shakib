<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fitsSystemWindows="true">

    <!-- Top Bar with Close X -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:background="@color/app_background"
        android:paddingHorizontal="14dp">

        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_close_thin"
            app:tint="@color/icon_tint_primary"
            android:contentDescription="Close" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/ivClose"
            android:text="Verify Death Certificate"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Scrollable Body Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:layout_above="@id/btnVerifyDeathCertificate"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <!-- Section Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Add Details"
                android:textColor="@color/text_primary"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <!-- Info Pill / Banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="13dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@id/ivInfo"
                        android:layout_marginEnd="12dp"
                        android:text="Read more information about the service here"
                        android:textColor="@color/icon_tint_primary"
                        android:textSize="13.5sp" />

                    <ImageView
                        android:id="@+id/ivInfo"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_info_outline"
                        app:tint="@color/icon_tint_primary"
                        android:contentDescription="Info" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Main Card: Death Certificate Details -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Death Certificate Details"
                        android:textColor="@color/text_primary"
                        android:textSize="16.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Add the certificate details to be able to view the document"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="15dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/divider_color" />

                    <!-- 1. ID Number -->
                    <LinearLayout
                        android:id="@+id/containerIdNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:background="@drawable/shape_input_field_bg"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="9dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ID Number"
                            android:textColor="@color/text_secondary"
                            android:textSize="11.5sp" />

                        <EditText
                            android:id="@+id/etIdNumber"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:background="@null"
                            android:hint="Enter ID Number"
                            android:inputType="number"
                            android:maxLines="1"
                            android:padding="0dp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="14.5sp" />
                    </LinearLayout>

                    <!-- 2. Calendar -->
                    <LinearLayout
                        android:id="@+id/containerCalendar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/shape_input_field_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="9dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Calendar"
                            android:textColor="@color/text_secondary"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/tvCalendar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Gregorian"
                            android:textColor="@color/text_primary"
                            android:textSize="14.5sp" />
                    </LinearLayout>

                    <!-- 3. Date of Birth -->
                    <LinearLayout
                        android:id="@+id/containerDob"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/shape_input_field_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="9dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Date of Birth"
                            android:textColor="@color/text_secondary"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/tvDob"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:hint="Select Date of Birth"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="14.5sp" />
                    </LinearLayout>

                    <!-- 4. Death Certificate Number -->
                    <LinearLayout
                        android:id="@+id/containerDeathCertNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/shape_input_field_bg"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="9dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Death Certificate Number"
                            android:textColor="@color/text_secondary"
                            android:textSize="11.5sp" />

                        <EditText
                            android:id="@+id/etDeathCertNumber"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:background="@null"
                            android:hint="Enter Death Certificate Number"
                            android:inputType="number"
                            android:maxLines="1"
                            android:padding="0dp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="14.5sp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVerifyDeathCertificate"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        app:backgroundTint="@color/btn_service_action_bg"
        app:cornerRadius="25dp"
        app:elevation="0dp"
        android:textAllCaps="false"
        android:text="Verify Death Certificate"
        android:textColor="@color/btn_service_action_text"
        android:textSize="15sp"
        android:textStyle="bold" />

</RelativeLayout>
