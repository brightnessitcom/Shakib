<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_item_license"
    android:layout_width="160dp"
    android:layout_height="100dp"
    android:layout_margin="8dp"
    card_view:cardCornerRadius="22dp"
    card_view:cardElevation="4dp">
    <LinearLayout
        android:orientation="horizontal"
        android:padding="15dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/driving_ic"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="8dp"
            android:text="@string/My_Driving_License"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
