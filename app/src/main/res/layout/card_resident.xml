<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardUseCompatPadding="true"
    app:strokeWidth="0dp">

    <LinearLayout
        android:orientation="vertical"
        android:background="@color/card_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/iqama_ic"
                app:tint="@color/text_secondary"
                android:scaleType="centerInside"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/my_resident_id_title"/>
        </LinearLayout>

        <View
            android:background="@color/divider_color"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:paddingBottom="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/resident_id_number_label"/>

            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp">

                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/text_secondary"
                    android:id="@+id/resident_id_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/iqama_number_withidTow"
                    android:layout_weight="1"/>

                <ImageView
                    android:id="@+id/copyimgiconresedent"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_cpy"
                    app:tint="@color/icon_tint_primary"
                    android:contentDescription="@string/copy_icon_description"/>
            </LinearLayout>

            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:paddingBottom="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/id_version_label"/>

            <TextView
                android:textSize="15sp"
                android:textColor="@color/text_secondary"
                android:id="@+id/id_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:text="@string/id_verson"/>

            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:paddingBottom="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/issuing_date_label"/>

            <TextView
                android:textSize="15sp"
                android:textColor="@color/text_secondary"
                android:id="@+id/issue_date_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:text="@string/iqamaIssue"/>

            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:paddingBottom="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/expiry_date_label"/>

            <TextView
                android:textSize="15sp"
                android:textColor="@color/text_secondary"
                android:id="@+id/expiry_date_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/iqamaExpire"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
