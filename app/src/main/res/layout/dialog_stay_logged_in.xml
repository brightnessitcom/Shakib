<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_stay_logged_in"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="26dp"
    android:paddingBottom="22dp">

    <!-- Modal Title -->
    <TextView
        android:id="@+id/tvModalTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/stay_logged_in_title"
        android:textColor="@color/text_primary"
        android:textSize="21sp"
        android:textStyle="bold" />

    <!-- Modal Body matching line-by-line exact format -->
    <TextView
        android:id="@+id/tvModalBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/stay_logged_in_body"
        android:textColor="@color/text_secondary"
        android:textSize="14.5sp"
        android:lineSpacingExtra="5dp"
        android:lineSpacingMultiplier="1.2" />

    <!-- Action Buttons Row matching exact order: Stay Logged In, Not Now, Cancel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnModalStayLoggedIn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/btn_stay_logged_in"
            android:textColor="@color/icon_tint_primary"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnModalNotNow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/btn_not_now"
            android:textColor="@color/icon_tint_primary"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnModalCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/nafath_cancel"
            android:textColor="@color/icon_tint_primary"
            android:textSize="14.5sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
