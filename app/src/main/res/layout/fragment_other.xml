<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical">

    <!-- Top Header Bar -->
    <RelativeLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- Logos (shown when at top) -->
        <LinearLayout
            android:id="@+id/leftIcons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ab2"
                app:tint="@color/icon_tint_secondary"
                android:contentDescription="Absher Logo" />

            <ImageView
                android:layout_width="38dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ministry_ic"
                app:tint="@color/icon_tint_secondary"
                android:contentDescription="Ministry Logo" />
        </LinearLayout>

        <!-- Sticky Header Title (shown when scrolled down) -->
        <TextView
            android:id="@+id/tvStickyHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="@string/other_services_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Top Right Action Icons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/settingsIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="18dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="false"
                android:src="@drawable/setting"
                app:tint="@color/icon_tint_primary"
                android:contentDescription="Settings" />

            <ImageView
                android:id="@+id/notificationsIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="false"
                android:src="@drawable/ic_bell_outline"
                app:tint="@color/icon_tint_primary"
                android:contentDescription="Notifications" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/otherScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:descendantFocusability="beforeDescendants"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Title: Other Services -->
            <TextView
                android:id="@+id/tvMainOtherServicesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:text="@string/other_services_title"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Search Bar: Search by Service -->
            <LinearLayout
                android:id="@+id/searchBarContainer"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_search_capsule"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_search_18"
                    app:tint="@color/search_hint"
                    android:contentDescription="Search Icon" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/search_by_service"
                    android:textColor="@color/search_hint"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Banner Card: Personalise your Space -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPersonaliseBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/banner_card_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Left Accent Strip (Full Height on Left Border) -->
                    <View
                        android:id="@+id/blueAccentStrip"
                        android:layout_width="4dp"
                        android:layout_height="0dp"
                        android:layout_alignParentStart="true"
                        android:layout_alignTop="@id/bannerContentLayout"
                        android:layout_alignBottom="@id/bannerContentLayout"
                        android:background="@drawable/bg_blue_accent_strip" />

                    <LinearLayout
                        android:id="@+id/bannerContentLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/blueAccentStrip"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingTop="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginTop="1dp"
                                android:src="@drawable/ic_info_circle"
                                android:contentDescription="Info Icon" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/personalise_space_banner_title"
                                    android:textColor="@color/text_primary"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:lineSpacingExtra="2dp"
                                    android:text="@string/personalise_space_banner_desc"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Banner Actions Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center_vertical|end"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvBannerPersonaliseSpace"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="false"
                                android:paddingVertical="4dp"
                                android:paddingHorizontal="6dp"
                                android:text="@string/personalise_space_title"
                                android:textColor="@color/icon_tint_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <FrameLayout
                                android:id="@+id/btnDismissBanner"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginStart="14dp"
                                android:background="@drawable/bg_dismiss_banner_circle"
                                android:clickable="true"
                                android:focusable="false">

                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_close_thin"
                                    app:tint="@color/banner_dismiss_cross_tint"
                                    android:contentDescription="Dismiss" />
                            </FrameLayout>
                        </LinearLayout>

                    </LinearLayout>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Section 1: Preferred Services (Pattern Background) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/preferred_services_bg">

                <!-- Vertical Pattern Watermark on Left (Exact Official Absher Pattern from before-login page) -->
                <ImageView
                    android:id="@+id/ivPreferredPatternWatermark"
                    android:layout_width="173dp"
                    android:layout_height="220dp"
                    android:layout_gravity="top|start"
                    android:scaleType="fitStart"
                    android:src="@drawable/ic_absher_header_pattern"
                    android:contentDescription="Background Pattern" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="20dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginBottom="14dp"
                        android:text="@string/preferred_services_title"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Dynamic Container for Preferred Services -->
                    <LinearLayout
                        android:id="@+id/llPreferredContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </FrameLayout>

            <!-- Section 2: Other Services (Clean App Background) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/app_background"
                android:orientation="vertical"
                android:paddingTop="14dp"
                android:paddingBottom="24dp">

                <!-- Dynamic Container for Other Services -->
                <LinearLayout
                    android:id="@+id/llOtherContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Bottom Personalise Space Action Button -->
                <LinearLayout
                    android:id="@+id/btnPersonaliseSpace"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="24dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_pencil_edit"
                        app:tint="@color/icon_tint_primary"
                        android:contentDescription="Edit" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/personalise_space_title"
                        android:textColor="@color/icon_tint_primary"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>