<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="6dp">

    <!-- Description -->
    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="3.5dp"
        android:text="@string/personalise_space_instruction"
        android:textColor="@color/text_secondary"
        android:textSize="13.5sp" />

    <!-- Preferred Services Title -->
    <TextView
        android:id="@+id/tvPreferredTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/preferred_services_title"
        android:textColor="@color/text_primary"
        android:textSize="18.5sp"
        android:textStyle="bold" />

    <!-- Info message -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ic_info_circle"
            app:tint="@color/text_secondary"
            android:contentDescription="Info" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/personalise_space_max_limit"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp" />
    </LinearLayout>

</LinearLayout>
