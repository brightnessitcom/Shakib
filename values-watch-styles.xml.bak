<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base_Theme_AppCompat_Dialog" parent="@style/Base.V21.Theme.AppCompat.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowElevation">0dp</item>
    </style>
    <style name="Base_Theme_AppCompat_Light_Dialog" parent="@style/Base.V21.Theme.AppCompat.Light.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowElevation">0dp</item>
    </style>
    <style name="Base_ThemeOverlay_AppCompat_Dialog" parent="@style/Base.V21.ThemeOverlay.AppCompat.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowElevation">0dp</item>
    </style>
</resources>

